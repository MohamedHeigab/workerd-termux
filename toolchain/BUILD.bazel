package(default_visibility = ["//visibility:public"])

load(":cc_toolchain_config.bzl", "android_cc_toolchain_config")

# Platforms defined inside toolchain package as well
platform(
    name = "android_aarch64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "android_x86_64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "empty",
    srcs = [],
)

filegroup(
    name = "wrappers",
    srcs = glob(["wrappers/*"]),
)

android_cc_toolchain_config(
    name = "android_aarch64_toolchain_config",
    target_triple = "aarch64-linux-android",
    target_cpu = "arm64-v8a",
    api_level = 24,
    ndk_path = "$$ANDROID_NDK_HOME$$",
)

cc_toolchain(
    name = "android_aarch64_cc_toolchain",
    toolchain_identifier = "android_bionic_toolchain_aarch64",
    toolchain_config = ":android_aarch64_toolchain_config",
    all_files = ":wrappers",
    ar_files = ":wrappers",
    as_files = ":wrappers",
    compiler_files = ":wrappers",
    dwp_files = ":empty",
    linker_files = ":wrappers",
    objcopy_files = ":empty",
    strip_files = ":wrappers",
    supports_param_files = 1,
)

toolchain(
    name = "android_aarch64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
    toolchain = ":android_aarch64_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

android_cc_toolchain_config(
    name = "android_x86_64_toolchain_config",
    target_triple = "x86_64-linux-android",
    target_cpu = "x86_64",
    api_level = 24,
    ndk_path = "$$ANDROID_NDK_HOME$$",
)

cc_toolchain(
    name = "android_x86_64_cc_toolchain",
    toolchain_identifier = "android_bionic_toolchain_x86_64",
    toolchain_config = ":android_x86_64_toolchain_config",
    all_files = ":wrappers",
    ar_files = ":wrappers",
    as_files = ":wrappers",
    compiler_files = ":wrappers",
    dwp_files = ":empty",
    linker_files = ":wrappers",
    objcopy_files = ":empty",
    strip_files = ":wrappers",
    supports_param_files = 1,
)

toolchain(
    name = "android_x86_64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":android_x86_64_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
