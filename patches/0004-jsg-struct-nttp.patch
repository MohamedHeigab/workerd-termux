   registry.template registerStructProperty<decltype(::kj::instance<Self>().name), &Self::name>(    \
-      name##_JSG_NAME_DO_NOT_USE_DIRECTLY)
+      name##_JSG_NAME_DO_NOT_USE_DIRECTLY.value)
 
