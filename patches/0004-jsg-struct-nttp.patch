@@ -787,29 +787,38 @@ concept HasStructTypeScriptDefine = requires { T::_JSG_STRUCT_TS_DEFINE_DO_NOT_U
     registerMembersInternal<Registry, Self, jsg::GetConfiguration<Self>>(registry, arg);           \
