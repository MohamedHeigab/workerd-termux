       &Self::name,                                                                                 \
-      name##_JSG_NAME_DO_NOT_USE_DIRECTLY + ::workerd::jsg::prefixLengthToStrip(#name)>
+      name##_JSG_NAME_DO_NOT_USE_DIRECTLY.value>
